{
  "manifest_version": 3,
  "name": "Quick UC",
  "version": "2.0",
  "description": "Launch frequently used web pages for PUC students",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://buscacursos.uc.cl/*",
    "*://sso.uc.cl/*",
    "*://cas-v2.mat.uc.cl/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "180": "images/icon-180.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "180": "images/icon-180.png",
    "192": "images/icon-192.png",
    "512": "images/icon-512.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://buscacursos.uc.cl/*"],
      "js": ["buscacursos.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://sso.uc.cl/cas/login*",
        "*://cas-v2.mat.uc.cl/jwt/login*"
      ],
      "js": ["cas.js", "labmat.js"]
    }
  ]
}
